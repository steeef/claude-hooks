{
  "description": "Dewraps hard-wrapped prose in gh pr/issue body files before submission",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/gh_body_dewrap.py"
          }
        ]
      }
    ]
  }
}
